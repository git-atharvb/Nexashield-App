/* ============================================================
   NexaShield - Dark Theme Stylesheet
   Applied globally via QPalette + this QSS in main.py
   ============================================================ */

QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 10pt;
}

QLabel {
    background: transparent;
    color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #1e1e1e;
}

/* ---------- Auth / Login Shell ---------- */
QWidget#AuthWindow {
    background-color: #0b0f19;
}

QFrame#AuthFrame {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 16px;
}

QLabel#LoginTitle, QLabel#SignupTitle {
    font-size: 26px;
    font-weight: 900;
    color: #ffffff;
    padding-bottom: 2px;
}

QLabel#AuthSubtitle {
    font-size: 13px;
    color: #8b949e;
    padding-bottom: 12px;
}

QLabel#SuccessTitle {
    font-size: 16px;
    font-weight: bold;
    color: #28a745;
}

QLabel#SuccessMsg {
    font-size: 12px;
    color: #cccccc;
}

QFrame#SuccessDialogContainer {
    background-color: #2b2b2b;
    border: 1px solid #3e3e42;
    border-radius: 14px;
}

QLabel#SuccessIcon, QLabel#LogoutIcon {
    font-size: 42px;
}

/* ---------- Inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QTimeEdit {
    background-color: #333333;
    border: 1px solid #3e3e42;
    border-radius: 6px;
    padding: 6px 8px;
    color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #0078d7;
}

QFrame#PasswordFrame {
    background-color: #333333;
    border: 1px solid #3e3e42;
    border-radius: 6px;
}

QLineEdit#PasswordLineEdit {
    background: transparent;
    border: none;
    padding: 6px 4px;
}

QToolButton#VisibilityButton {
    background: transparent;
    border: none;
    color: #aaaaaa;
    font-size: 14px;
    padding: 0 6px;
}

QToolButton#VisibilityButton:hover {
    color: #ffffff;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #3e3e42;
    border-radius: 6px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #3f3f46;
    border: 1px solid #0078d7;
}

QPushButton:pressed {
    background-color: #0078d7;
}

QPushButton:disabled {
    background-color: #2a2a2a;
    color: #666666;
    border: 1px solid #333333;
}

QPushButton#ThemeToggle {
    background: transparent;
    border: none;
    font-size: 18px;
    padding: 0;
}

QPushButton#ThemeToggle:hover {
    background-color: #3f3f46;
    border-radius: 8px;
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: #4aa3ff;
    padding: 4px;
}

QPushButton#LinkButton:hover {
    color: #82c2ff;
    text-decoration: underline;
}

QPushButton#LogoutButton {
    background-color: #c0392b;
    border: none;
    font-weight: bold;
}

QPushButton#LogoutButton:hover {
    background-color: #e0493b;
}

QPushButton#NavButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    color: #cccccc;
}

QPushButton#NavButton:hover {
    background-color: #3f3f46;
    color: #ffffff;
}

QPushButton#NavButton:checked {
    background-color: #0078d7;
    color: #ffffff;
    font-weight: bold;
}

/* ---------- Colored Action Buttons ---------- */
QPushButton#AuthPrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a73e8, stop:1 #2892f0);
    color: #ffffff;
    border: none;
    font-weight: 800;
    font-size: 14px;
    padding: 10px;
    border-radius: 8px;
}
QPushButton#AuthPrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2892f0, stop:1 #1a73e8);
}
QPushButton#AuthPrimaryButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a73e8, stop:1 #2892f0);
    color: #ffffff;
}

QPushButton#AuthOrangeButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d35400, stop:1 #e67e22);
    color: #ffffff;
    border: none;
    font-weight: 800;
    font-size: 14px;
    padding: 10px;
    border-radius: 8px;
}
QPushButton#AuthOrangeButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e67e22, stop:1 #d35400);
}
QPushButton#AuthOrangeButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d35400, stop:1 #e67e22);
    color: #ffffff;
}

QPushButton#AuthGreenButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #27ae60, stop:1 #2ecc71);
    color: #ffffff;
    border: none;
    font-weight: 800;
    font-size: 14px;
    padding: 10px;
    border-radius: 8px;
}
QPushButton#AuthGreenButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2ecc71, stop:1 #27ae60);
}
QPushButton#AuthGreenButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #27ae60, stop:1 #2ecc71);
    color: #ffffff;
}

QPushButton#BtnPrimary { background-color: #0078d7; border: none; font-weight: bold; }
QPushButton#BtnPrimary:hover { background-color: #0063b1; }

QPushButton#BtnSecondary { background-color: #5a5a5a; border: none; }
QPushButton#BtnSecondary:hover { background-color: #6b6b6b; }

QPushButton#BtnSuccess { background-color: #28a745; border: none; font-weight: bold; }
QPushButton#BtnSuccess:hover { background-color: #218838; }

QPushButton#BtnDanger { background-color: #dc3545; border: none; font-weight: bold; }
QPushButton#BtnDanger:hover { background-color: #c82333; }

QPushButton#BtnWarning { background-color: #ffc107; color: #1e1e1e; border: none; font-weight: bold; }
QPushButton#BtnWarning:hover { background-color: #e0a800; }

QPushButton#BtnInfo { background-color: #17a2b8; border: none; }
QPushButton#BtnInfo:hover { background-color: #138496; }

QPushButton#BtnPurple { background-color: #8e44ad; border: none; }
QPushButton#BtnPurple:hover { background-color: #7d3c98; }

QPushButton#BtnIndigo { background-color: #3f51b5; border: none; }
QPushButton#BtnIndigo:hover { background-color: #354497; }

QPushButton#BtnQuarantine { background-color: #e67e22; border: none; font-weight: bold; }
QPushButton#BtnQuarantine:hover { background-color: #d35400; }

QPushButton#GoogleButton {
    background-color: #ffffff;
    color: #444444;
    border: 1px solid #cccccc;
    font-weight: bold;
}

QPushButton#GoogleButton:hover {
    background-color: #f1f1f1;
}

/* ---------- Cards & Frames ---------- */
QFrame#AuthFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(30, 35, 45, 0.85), stop:1 rgba(15, 20, 25, 0.9));
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
}

QPushButton#LinkButton {
    background: transparent;
    color: #ffffff;
    border: none;
    font-weight: 500;
}
QPushButton#LinkButton:hover {
    color: #00c6ff;
    text-decoration: underline;
}

/* ---------- Navbar / Cards ---------- */
QFrame#Navbar {
    background-color: #252526;
    border-bottom: 1px solid #3e3e42;
}

QLabel#NavbarTitle {
    font-size: 18px;
    font-weight: 800;
    color: #0078d7;
}

/* ---------- Process Tab Specifics ---------- */
QFrame#ChartCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(30, 35, 45, 0.6), stop:1 rgba(15, 20, 25, 0.8));
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

QFrame#ProcessToolbar {
    background: rgba(20, 25, 30, 0.8);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QFrame#ProcessTableContainer {
    background: rgba(20, 25, 30, 0.6);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

QTableWidget#ProcessTable {
    background: transparent;
    border: none;
    color: #e0e0e0;
}
QTableWidget#ProcessTable::item:selected {
    background-color: rgba(0, 198, 255, 0.2);
}
QTableWidget#ProcessTable QHeaderView::section {
    background-color: transparent;
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
    padding: 8px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

/* Process Status Badges */
#ProcessResourceBar {
    border: none;
    border-radius: 4px;
    background-color: #2d2d30;
    text-align: center;
    color: white;
    font-weight: bold;
    font-size: 10px;
}
#ProcessResourceBar::chunk {
    border-radius: 4px;
}

/* Deep Dive Details Panel */
#DetailsPanel {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 8px;
}
#DetailsTitle {
    font-size: 16px;
    font-weight: bold;
    color: #00c6ff;
    padding-bottom: 5px;
    border-bottom: 1px solid #333333;
}
#DetailsInfo {
    font-size: 13px;
    color: #dddddd;
    line-height: 1.5;
}

/* Filter Dropdown */
QComboBox#FilterDropdown {
    background-color: #2d2d30;
    border: 1px solid #444444;
    border-radius: 8px;
    color: #ffffff;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: bold;
}
QComboBox#FilterDropdown::drop-down {
    border: none;
    width: 24px;
}
QComboBox#FilterDropdown::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #aaaaaa;
    margin-right: 8px;
}
QComboBox#FilterDropdown QAbstractItemView {
    background-color: #1e1e1e;
    border: 1px solid #444444;
    color: #ffffff;
    selection-background-color: #0078d7;
}

QPushButton#ClearSearchBtn {
    background-color: rgba(255, 71, 87, 0.1);
    color: #ff4757;
    border: 1px solid rgba(255, 71, 87, 0.4);
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    font-family: Arial, sans-serif;
    padding: 0px;
    margin: 0px;
}
QPushButton#ClearSearchBtn:hover {
    background-color: #ff4757;
    color: white;
    border: 1px solid #ff4757;
}

QPushButton#BtnIcon {
    background: transparent;
    color: #e0e0e0;
    border: none;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#BtnIcon:hover {
    color: #ff5e7e;
}

QPushButton#BtnOutline {
    background: transparent;
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
}
QPushButton#BtnOutline:hover {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.4);
}

QCheckBox#ProcessCheckBox {
    color: #ffffff;
    font-weight: bold;
}

QFrame#CardContainer {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(45, 45, 48, 180), stop:1 rgba(30, 30, 35, 120));
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 12px;
}

QFrame#ConfigCard {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 10px;
}

QLabel#HeaderTitle {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#SchedTitle {
    font-size: 18px;
    font-weight: bold;
    color: #0078d7;
}

QLabel#SchedDesc {
    color: #aaaaaa;
}

QLabel#PlaceholderLabel {
    font-size: 18px;
    color: #888888;
}

/* ---------- Status badges ---------- */
QLabel#StatusRed {
    color: #dc3545;
    font-weight: bold;
}

QLabel#StatusGreen {
    color: #28a745;
    font-weight: bold;
}

QLabel#StatusBarLabel {
    color: #28a745;
}

/* ---------- Progress bars ---------- */
QProgressBar {
    background-color: #333333;
    border: 1px solid #3e3e42;
    border-radius: 5px;
    text-align: center;
    color: #ffffff;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #0078d7;
    border-radius: 4px;
}

QProgressBar#AntivirusProgress::chunk {
    background-color: #28a745;
}

QProgressBar#ScoreBar::chunk {
    background-color: #0078d7;
}

QProgressBar#StrengthBar {
    border: none;
}

/* ---------- Tables ---------- */
QTableWidget {
    background-color: #252526;
    gridline-color: #3e3e42;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    alternate-background-color: #2b2b2b;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
}

QTableWidget::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #3e3e42;
    padding: 6px;
    font-weight: bold;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #3e3e42;
    border-radius: 8px;
    background-color: #1e1e1e;
}

QTabBar::tab {
    background-color: #333333;
    color: #cccccc;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #0078d7;
    color: #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #3f3f46;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #777777;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 5px;
    min-width: 20px;
}

/* ---------- Group boxes / Checkboxes ---------- */
QGroupBox {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    color: #4aa3ff;
}

QCheckBox {
    background: transparent;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    background-color: #333333;
}

QCheckBox::indicator:checked {
    background-color: #0078d7;
}

/* ---------- ComboBox ---------- */
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #ffffff;
    selection-background-color: #0078d7;
    border: 1px solid #3e3e42;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* ---------- Dialogs / Detail panels ---------- */
QLabel#DialogTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0078d7;
}

QLabel#DialogKey {
    color: #aaaaaa;
    font-weight: bold;
}

QLabel#ThreatLabel {
    font-size: 16px;
    font-weight: bold;
    color: #0078d7;
}

QLabel#ReasonLabel, QLabel#DetailsLabel {
    color: #cccccc;
}

/* ---------- SIEM sidebar ---------- */
QFrame#SIEMSidebar {
    background-color: #252526;
    border-right: 1px solid #3e3e42;
}

QLabel#SidebarTitle {
    font-size: 14px;
    font-weight: bold;
    color: #4aa3ff;
}

/* ---------- Metric / Info cards ---------- */
QFrame#MetricCard {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 10px;
}

QLabel#MetricTitle {
    color: #aaaaaa;
    font-size: 11px;
}

QLabel#MetricValue {
    font-size: 22px;
    font-weight: bold;
}

QFrame#InfoCard {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 8px;
}

QLabel#InfoIcon {
    font-size: 20px;
}

QLabel#InfoTitle {
    color: #aaaaaa;
    font-size: 11px;
}

QLabel#InfoValue {
    color: #ffffff;
    font-weight: bold;
}

/* ---------- Strength label ---------- */
QLabel#StrengthLabel {
    color: #aaaaaa;
    font-size: 10px;
}