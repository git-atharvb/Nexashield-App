/* ============================================================
   NexaShield - Light Theme Stylesheet
   Applied globally via QPalette + this QSS in main.py
   ============================================================ */

QWidget {
    background-color: #f3f3f3;
    color: #111111;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 10pt;
}

QLabel {
    background: transparent;
    color: #111111;
}

QMainWindow, QDialog {
    background-color: #f3f3f3;
}

/* ---------- Auth / Login Shell ---------- */
QWidget#AuthWindow {
    background-color: #f6f8fa;
}

QFrame#AuthFrame {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 16px;
}

QLabel#LoginTitle, QLabel#SignupTitle {
    font-size: 26px;
    font-weight: 900;
    color: #24292f;
    padding-bottom: 2px;
}

QLabel#AuthSubtitle {
    font-size: 13px;
    color: #57606a;
    padding-bottom: 12px;
}

QLabel#SuccessTitle {
    font-size: 16px;
    font-weight: bold;
    color: #1e7e34;
}

QLabel#SuccessMsg {
    font-size: 12px;
    color: #555555;
}

QFrame#SuccessDialogContainer {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 14px;
}

QLabel#SuccessIcon, QLabel#LogoutIcon {
    font-size: 42px;
}

/* ---------- Inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QTimeEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 6px 8px;
    color: #111111;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #0078d7;
}

QFrame#PasswordFrame {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
}

QLineEdit#PasswordLineEdit {
    background: transparent;
    border: none;
    padding: 6px 4px;
}

QToolButton#VisibilityButton {
    background: transparent;
    border: none;
    color: #555555;
    font-size: 14px;
    padding: 0 6px;
}

QToolButton#VisibilityButton:hover {
    color: #111111;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #e9e9e9;
    color: #111111;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #dcdcdc;
    border: 1px solid #0078d7;
}

QPushButton:pressed {
    background-color: #0078d7;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #aaaaaa;
    border: 1px solid #dddddd;
}

QPushButton#ThemeToggle {
    background: transparent;
    border: none;
    font-size: 18px;
    padding: 0;
}

QPushButton#ThemeToggle:hover {
    background-color: #dcdcdc;
    border-radius: 8px;
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: #005a9e;
    padding: 4px;
}

QPushButton#LinkButton:hover {
    color: #0078d7;
    text-decoration: underline;
}

QPushButton#LogoutButton {
    background-color: #c0392b;
    color: #ffffff;
    border: none;
    font-weight: bold;
}

QPushButton#LogoutButton:hover {
    background-color: #e0493b;
}

QPushButton#NavButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    color: #555555;
}

QPushButton#NavButton:hover {
    background-color: #dcdcdc;
    color: #111111;
}

QPushButton#NavButton:checked {
    background-color: #0078d7;
    color: #ffffff;
    font-weight: bold;
}

/* ---------- Colored Action Buttons ---------- */
QPushButton#AuthPrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a73e8, stop:1 #2892f0);
    color: #ffffff;
    border: none;
    font-weight: 800;
    font-size: 14px;
    padding: 10px;
    border-radius: 8px;
}
QPushButton#AuthPrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2892f0, stop:1 #1a73e8);
}
QPushButton#AuthPrimaryButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a73e8, stop:1 #2892f0);
    color: #ffffff;
}

QPushButton#AuthOrangeButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d35400, stop:1 #e67e22);
    color: #ffffff;
    border: none;
    font-weight: 800;
    font-size: 14px;
    padding: 10px;
    border-radius: 8px;
}
QPushButton#AuthOrangeButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e67e22, stop:1 #d35400);
}
QPushButton#AuthOrangeButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d35400, stop:1 #e67e22);
    color: #ffffff;
}

QPushButton#AuthGreenButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #27ae60, stop:1 #2ecc71);
    color: #ffffff;
    border: none;
    font-weight: 800;
    font-size: 14px;
    padding: 10px;
    border-radius: 8px;
}
QPushButton#AuthGreenButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2ecc71, stop:1 #27ae60);
}
QPushButton#AuthGreenButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #27ae60, stop:1 #2ecc71);
    color: #ffffff;
}

QPushButton#BtnPrimary { background-color: #0078d7; color: #ffffff; border: none; font-weight: bold; }
QPushButton#BtnPrimary:hover { background-color: #005a9e; }

QPushButton#BtnSecondary { background-color: #6c757d; color: #ffffff; border: none; }
QPushButton#BtnSecondary:hover { background-color: #5a6268; }

QPushButton#BtnSuccess { background-color: #28a745; color: #ffffff; border: none; font-weight: bold; }
QPushButton#BtnSuccess:hover { background-color: #218838; }

QPushButton#BtnDanger { background-color: #dc3545; color: #ffffff; border: none; font-weight: bold; }
QPushButton#BtnDanger:hover { background-color: #c82333; }

QPushButton#BtnWarning { background-color: #ffc107; color: #111111; border: none; font-weight: bold; }
QPushButton#BtnWarning:hover { background-color: #e0a800; }

QPushButton#BtnInfo { background-color: #17a2b8; color: #ffffff; border: none; }
QPushButton#BtnInfo:hover { background-color: #138496; }

QPushButton#BtnPurple { background-color: #8e44ad; color: #ffffff; border: none; }
QPushButton#BtnPurple:hover { background-color: #7d3c98; }

QPushButton#BtnIndigo { background-color: #3f51b5; color: #ffffff; border: none; }
QPushButton#BtnIndigo:hover { background-color: #354497; }

QPushButton#BtnQuarantine { background-color: #e67e22; color: #ffffff; border: none; font-weight: bold; }
QPushButton#BtnQuarantine:hover { background-color: #d35400; }

QPushButton#GoogleButton {
    background-color: #ffffff;
    color: #444444;
    border: 1px solid #cccccc;
    font-weight: bold;
}

QPushButton#GoogleButton:hover {
    background-color: #f1f1f1;
}

/* ---------- Cards & Frames ---------- */
QFrame#AuthFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(255, 255, 255, 0.75), stop:1 rgba(245, 245, 250, 0.85));
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 1.0);
}

QPushButton#LinkButton {
    background: transparent;
    color: #444444;
    border: none;
    font-weight: 500;
}
QPushButton#LinkButton:hover {
    color: #0078d7;
    text-decoration: underline;
}

/* ---------- Navbar / Cards ---------- */
QFrame#Navbar {
    background-color: #ffffff;
    border-bottom: 1px solid #cccccc;
}

QLabel#NavbarTitle {
    font-size: 18px;
    font-weight: 800;
    color: #0078d7;
}

/* ---------- Process Tab Specifics ---------- */
QFrame#ChartCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(255, 255, 255, 0.9), stop:1 rgba(240, 245, 250, 0.8));
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

QFrame#ProcessToolbar {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.15);
}

QFrame#ProcessTableContainer {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

QTableWidget#ProcessTable {
    background: transparent;
    border: none;
    color: #333333;
}
QTableWidget#ProcessTable::item:selected {
    background-color: rgba(0, 198, 255, 0.2);
    color: #000000;
}
QTableWidget#ProcessTable QHeaderView::section {
    background-color: transparent;
    color: #333333;
    font-weight: bold;
    font-size: 11px;
    padding: 8px;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

/* Process Status Badges */
#ProcessResourceBar {
    border: none;
    border-radius: 4px;
    background-color: #e0e0e0;
    text-align: center;
    color: #333333;
    font-weight: bold;
    font-size: 10px;
}
#ProcessResourceBar::chunk {
    border-radius: 4px;
}

/* Deep Dive Details Panel */
#DetailsPanel {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 8px;
}
#DetailsTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0078d7;
    padding-bottom: 5px;
    border-bottom: 1px solid #eeeeee;
}
#DetailsInfo {
    font-size: 13px;
    color: #333333;
    line-height: 1.5;
}

/* Filter Dropdown */
QComboBox#FilterDropdown {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 8px;
    color: #333333;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: bold;
}
QComboBox#FilterDropdown::drop-down {
    border: none;
    width: 24px;
}
QComboBox#FilterDropdown::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #555555;
    margin-right: 8px;
}
QComboBox#FilterDropdown QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    color: #333333;
    selection-background-color: #0078d7;
}

QPushButton#ClearSearchBtn {
    background-color: rgba(255, 71, 87, 0.1);
    color: #ff4757;
    border: 1px solid rgba(255, 71, 87, 0.4);
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    font-family: Arial, sans-serif;
    padding: 0px;
    margin: 0px;
}
QPushButton#ClearSearchBtn:hover {
    background-color: #ff4757;
    color: white;
    border: 1px solid #ff4757;
}

QProgressBar#ProcessResourceBar {
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    color: #333333;
    font-weight: bold;
    text-align: center;
    margin: 4px 10px;
}
QProgressBar#ProcessResourceBar::chunk {
    border-radius: 4px;
}

QPushButton#BtnIcon {
    background: transparent;
    color: #555555;
    border: none;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#BtnIcon:hover {
    color: #ff5e7e;
}

QPushButton#BtnOutline {
    background: transparent;
    color: #333333;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
}
QPushButton#BtnOutline:hover {
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.4);
}

QCheckBox#ProcessCheckBox {
    color: #333333;
    font-weight: bold;
}

QFrame#CardContainer {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(255, 255, 255, 220), stop:1 rgba(240, 240, 245, 180));
    border: 1px solid rgba(0, 0, 0, 25);
    border-radius: 12px;
}

QFrame#ConfigCard {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 10px;
}

QLabel#HeaderTitle {
    font-size: 20px;
    font-weight: 800;
    color: #111111;
}

QLabel#SchedTitle {
    font-size: 18px;
    font-weight: bold;
    color: #0078d7;
}

QLabel#SchedDesc {
    color: #555555;
}

QLabel#PlaceholderLabel {
    font-size: 18px;
    color: #888888;
}

/* ---------- Status badges ---------- */
QLabel#StatusRed {
    color: #c0392b;
    font-weight: bold;
}

QLabel#StatusGreen {
    color: #1e7e34;
    font-weight: bold;
}

QLabel#StatusBarLabel {
    color: #1e7e34;
}

/* ---------- Progress bars ---------- */
QProgressBar {
    background-color: #e9e9e9;
    border: 1px solid #cccccc;
    border-radius: 5px;
    text-align: center;
    color: #111111;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #0078d7;
    border-radius: 4px;
}

QProgressBar#AntivirusProgress::chunk {
    background-color: #28a745;
}

QProgressBar#ScoreBar::chunk {
    background-color: #0078d7;
}

QProgressBar#StrengthBar {
    border: none;
}

/* ---------- Tables ---------- */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #dddddd;
    border: 1px solid #cccccc;
    border-radius: 8px;
    alternate-background-color: #f7f7f7;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
}

QTableWidget::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #e9e9e9;
    color: #111111;
    border: 1px solid #cccccc;
    padding: 6px;
    font-weight: bold;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #cccccc;
    border-radius: 8px;
    background-color: #f3f3f3;
}

QTabBar::tab {
    background-color: #e9e9e9;
    color: #555555;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #0078d7;
    color: #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #dcdcdc;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background-color: #f3f3f3;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #b0b0b0;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #909090;
}

QScrollBar:horizontal {
    background-color: #f3f3f3;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #b0b0b0;
    border-radius: 5px;
    min-width: 20px;
}

/* ---------- Group boxes / Checkboxes ---------- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    color: #005a9e;
}

QCheckBox {
    background: transparent;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cccccc;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0078d7;
}

/* ---------- ComboBox ---------- */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111111;
    selection-background-color: #0078d7;
    border: 1px solid #cccccc;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* ---------- Dialogs / Detail panels ---------- */
QLabel#DialogTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0078d7;
}

QLabel#DialogKey {
    color: #555555;
    font-weight: bold;
}

QLabel#ThreatLabel {
    font-size: 16px;
    font-weight: bold;
    color: #0078d7;
}

QLabel#ReasonLabel, QLabel#DetailsLabel {
    color: #333333;
}

/* ---------- SIEM sidebar ---------- */
QFrame#SIEMSidebar {
    background-color: #ffffff;
    border-right: 1px solid #cccccc;
}

QLabel#SidebarTitle {
    font-size: 14px;
    font-weight: bold;
    color: #005a9e;
}

/* ---------- Metric / Info cards ---------- */
QFrame#MetricCard {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 10px;
}

QLabel#MetricTitle {
    color: #555555;
    font-size: 11px;
}

QLabel#MetricValue {
    font-size: 22px;
    font-weight: bold;
}

QFrame#InfoCard {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
}

QLabel#InfoIcon {
    font-size: 20px;
}

QLabel#InfoTitle {
    color: #555555;
    font-size: 11px;
}

QLabel#InfoValue {
    color: #111111;
    font-weight: bold;
}

/* ---------- Strength label ---------- */
QLabel#StrengthLabel {
    color: #555555;
    font-size: 10px;
}